[
  {
    "id": "vless-websocket-early-data",
    "uri": "vless://11111111-1111-4111-8111-111111111111@edge.example.org:443?security=tls&type=ws&path=%2Fchat%3Fed%3D2048%26foo%3D1&host=cdn.example.org#VLESS-WS",
    "expected": {
      "name": "VLESS-WS",
      "type": "vless",
      "server": "edge.example.org",
      "port": 443,
      "network": "ws",
      "ws_path": "/chat?foo=1",
      "ws_early_data": 2048,
      "ws_header": "Sec-WebSocket-Protocol",
      "ws_host": "cdn.example.org",
      "udp": true
    }
  },
  {
    "id": "trojan-websocket-early-data",
    "uri": "trojan://secret@example.org:443?type=ws&path=%2Fstream%3Fed%3D512%26v%3D2&host=www.example.org#Trojan-WS",
    "expected": {
      "name": "Trojan-WS",
      "type": "trojan",
      "server": "example.org",
      "port": 443,
      "network": "ws",
      "ws_path": "/stream?v=2",
      "ws_early_data": 512,
      "ws_header": "Sec-WebSocket-Protocol",
      "ws_host": "www.example.org",
      "udp": true,
      "sni": "example.org"
    }
  },
  {
    "id": "vless-grpc-service",
    "uri": "vless://11111111-1111-4111-8111-111111111111@grpc.example.org:443?security=tls&type=grpc&serviceName=service%2Fone#VLESS-GRPC",
    "expected": {
      "name": "VLESS-GRPC",
      "type": "vless",
      "server": "grpc.example.org",
      "port": 443,
      "network": "grpc",
      "grpc_service": "service/one",
      "udp": true
    }
  },
  {
    "id": "ss-plaintext-colon-password",
    "uri": "ss://aes-128-gcm:hello%3Aworld@example.org:8388#%E6%B5%8B%E8%AF%95",
    "expected": {
      "name": "测试",
      "type": "ss",
      "server": "example.org",
      "port": 8388,
      "cipher": "aes-128-gcm",
      "password": "hello:world",
      "udp": true
    }
  },
  {
    "id": "ss-sip002-percent-encoded-padding",
    "uri": "ss://YWVzLTI1Ni1nY206c2VjcmV0IQ%3D%3D@example.org:443#SIP002",
    "expected": {
      "name": "SIP002",
      "type": "ss",
      "server": "example.org",
      "port": 443,
      "cipher": "aes-256-gcm",
      "password": "secret!",
      "udp": true
    }
  },
  {
    "id": "vless-reality-default-fingerprint",
    "uri": "vless://11111111-1111-4111-8111-111111111111@reality.example.org:443?security=reality&pbk=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA&sid=abcd&type=tcp#Reality",
    "expected": {
      "name": "Reality",
      "type": "vless",
      "server": "reality.example.org",
      "port": 443,
      "network": "tcp",
      "udp": true,
      "client-fingerprint": "chrome"
    }
  },
  {
    "id": "ss-sip002-obfs-udp-tfo",
    "uri": "ss://aes-128-gcm:pass@example.org:443?plugin=obfs-local%3Bobfs%3Dtls%3Bobfs-host%3Dcdn.example.org&uot=1&tfo=yes#SS",
    "expected": {
      "name": "SS",
      "type": "ss",
      "server": "example.org",
      "port": 443,
      "cipher": "aes-128-gcm",
      "password": "pass",
      "udp": true,
      "plugin": "obfs",
      "plugin_mode": "tls",
      "plugin_host": "cdn.example.org",
      "udp_over_tcp": true,
      "tfo": true
    }
  },
  {
