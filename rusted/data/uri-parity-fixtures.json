    "expected": {
      "name": "Trojan-WS",
      "type": "trojan",
      "server": "example.org",
      "port": 443,
      "network": "ws",
      "ws_path": "/stream?v=2",
      "ws_early_data": 512,
      "ws_header": "Sec-WebSocket-Protocol",
      "ws_host": "www.example.org",
      "udp": true,
      "sni": "example.org"
    }
  },
  {
    "id": "vless-grpc-service",
    "uri": "vless://11111111-1111-4111-8111-111111111111@grpc.example.org:443?security=tls&type=grpc&serviceName=service%2Fone#VLESS-GRPC",
    "expected": {
      "name": "VLESS-GRPC",
      "type": "vless",
      "server": "grpc.example.org",
