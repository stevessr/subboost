      "name": "测试",
      "type": "ss",
      "server": "example.org",
      "port": 8388,
      "cipher": "aes-128-gcm",
      "password": "hello:world",
      "udp": true
    }
  },
  {
    "id": "ss-sip002-percent-encoded-padding",
    "uri": "ss://YWVzLTI1Ni1nY206c2VjcmV0IQ%3D%3D@example.org:443#SIP002",
    "expected": {
      "name": "SIP002",
      "type": "ss",
      "server": "example.org",
      "port": 443,
      "cipher": "aes-256-gcm",
      "password": "secret!",
      "udp": true
    }
  },
  {
    "id": "vless-reality-default-fingerprint",
