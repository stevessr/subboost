#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=15
PROG=/usr/bin/subboost-rs
DATA=/etc/subboost-rs

start_service() {
    config_load subboost-rs
    local enabled bind port allow_private
    config_get_bool enabled main enabled 1
    [ "$enabled" = 1 ] || return 0
    config_get bind main bind '0.0.0.0'
    config_get port main port 3000
    config_get_bool allow_private main allow_private_sources 0
    case "$bind" in
        *[!0-9a-zA-Z.:\[\]-]*|'') logger -t subboost-rs 'Invalid listen address'; return 1 ;;
    esac
    case "$port" in
        *[!0-9]*|'') logger -t subboost-rs 'Invalid port'; return 1 ;;
    esac
    [ "$port" -ge 1024 ] && [ "$port" -le 65535 ] || return 1

    mkdir -p "$DATA" || return 1
    chown nobody:nogroup "$DATA" || return 1
    chmod 0700 "$DATA" || return 1

    procd_open_instance
    procd_set_param command "$PROG"
    procd_set_param user nobody
    procd_set_param env "SUBBOOST_BIND=$bind:$port"
    procd_append_param env "SUBBOOST_DB=$DATA/subboost.sqlite"
    procd_append_param env "SUBBOOST_TOKEN_FILE=$DATA/admin.token"
    procd_append_param env "SUBBOOST_ALLOW_PRIVATE_SOURCES=$allow_private"
    procd_set_param respawn 3600 5 5
    procd_set_param stderr 1
    procd_set_param stdout 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger 'subboost-rs'
}
